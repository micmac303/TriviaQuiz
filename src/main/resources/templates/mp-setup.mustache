{{> header}}

<h1>Multiplayer Trivia</h1>

<p>Add players (name + 6 categories each). Each turn a player answers an easy, then medium, then
hard question from their remaining categories &mdash; one wrong answer ends the turn. First to
clear all 6 categories wins.</p>

{{#error}}
  <p class="error">{{error}}</p>
{{/error}}

<h2>Players</h2>
{{#players}}
  <div class="player">
    <span><strong>{{name}}</strong> <span class="player-cats">{{#categories}}{{.}}; {{/categories}}</span></span>
    <form method="post" action="/multiplayer/remove">
      <input type="hidden" name="index" value="{{index}}">
      <button type="submit">Remove</button>
    </form>
  </div>
{{/players}}
{{^players}}
  <p>No players yet.</p>
{{/players}}

<h2>Add a player</h2>
<form method="post" action="/multiplayer/add">
  <p>
    <label for="name">Name:</label>
    <input type="text" id="name" name="name" required>
  </p>
  <p>Choose exactly 6 categories:
    <button type="button" onclick="pickRandomCategories(this.form)">Pick 6 random categories</button>
  </p>
  {{#categories}}
    <label>
      <input type="checkbox" name="categories" value="{{id}}">
      {{name}}
    </label><br/>
  {{/categories}}
  <p><button type="submit">Add player</button></p>
</form>

<script>
  // Clears the category checkboxes, then checks six of them chosen at random.
  function pickRandomCategories(form) {
    var boxes = Array.prototype.slice.call(
      form.querySelectorAll('input[name="categories"]'));
    boxes.forEach(function (box) { box.checked = false; });
    // Fisher-Yates shuffle, then check the first six.
    for (var i = boxes.length - 1; i > 0; i--) {
      var j = Math.floor(Math.random() * (i + 1));
      var tmp = boxes[i]; boxes[i] = boxes[j]; boxes[j] = tmp;
    }
    boxes.slice(0, 6).forEach(function (box) { box.checked = true; });
  }
</script>

<form method="post" action="/multiplayer/start">
  <button type="submit"{{^canStart}} disabled{{/canStart}}>Start game</button>
</form>

<p><a href="/">Back to home</a></p>

{{> footer}}
