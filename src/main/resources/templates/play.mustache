{{> header}}

{{! Everything below #room is drawn by room.js from the polled state, because what this device
    should be showing changes when other devices act. }}
<div id="room">
  <p class="room-status">Connecting...</p>
</div>

<form method="post" action="/play/leave" class="leave"{{#party}} onsubmit="return confirm('Leave the game? You can\'t rejoin until the next one.')"{{/party}}>
  <button type="submit" class="secondary">Leave game</button>
</form>

<script src="/js/room.js?v=14"></script>
<script src="/js/chat.js?v=2"></script>
<script>
  startRoom({ code: '{{code}}', mount: document.getElementById('room') });
  startChat({ code: '{{code}}' });
</script>

{{> footer}}
