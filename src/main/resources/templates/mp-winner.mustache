{{> header}}

<h1>&#127881; {{winner}} wins!</h1>

<h2>Final standings</h2>
<ol>
  {{#standings}}
    <li>{{name}} &mdash; {{cleared}} of {{total}} categories cleared</li>
  {{/standings}}
</ol>

<form method="post" action="/multiplayer/reset">
  <button type="submit">Play again (same players &amp; topics)</button>
</form>

<form method="post" action="/multiplayer/clear">
  <button type="submit">Start fresh (new players)</button>
</form>

<p><a href="/">Back to home</a></p>

{{> footer}}
