{{> header}}

<h1>{{title}}</h1>

<form method="get" action="/game">
  <p>
    <label for="category">Choose a category:</label>
    <select id="category" name="category">
      <option value="all">All Categories</option>
      {{#categories}}
        <option value="{{id}}">{{name}}</option>
      {{/categories}}
    </select>
  </p>
  <p>
    <label for="difficulty">Choose a difficulty:</label>
    <select id="difficulty" name="difficulty">
      <option value="any">Any Difficulty</option>
      <option value="easy">Easy</option>
      <option value="medium">Medium</option>
      <option value="hard">Hard</option>
    </select>
  </p>
  <button type="submit">Start quiz</button>
</form>

<h2>Or play with friends</h2>
<p><a href="/host">Host a networked game</a> &mdash; everyone plays on their own phone over Wi-Fi.</p>
<p><a href="/party/host">Host a Theme Party</a> &mdash; take turns picking a theme, everyone answers,
highest score after the last round wins.</p>
<p><a href="/multiplayer">Pass-the-device multiplayer</a> &mdash; take turns clearing your chosen
categories on this browser.</p>

{{> footer}}
